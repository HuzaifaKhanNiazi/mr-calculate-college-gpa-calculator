# Mr Calculate: Hostinger (Apache / LiteSpeed)
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# 1. www se bina-www par (sirf tab, jab SSL www ko bhi cover kare)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 2. /index.html ko / par bhejo
RewriteRule ^index\.html$ / [R=301,L]

# 3. /page.html ko /page par bhejo (duplicate URL nahi chahiye)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ /%1 [R=301,L,NE]

# 4. /page/ ko /page par bhejo
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5. /page ke liye page.html dikhao
RewriteCond %{REQUEST_URI} !^/404$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Speed: hashed assets ko lamba cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>